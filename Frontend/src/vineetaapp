      if (!text || loading) return;

      const userMsg = { id: Date.now() + "-u", role: "user", text };
      setMessages((prev) => [...prev, userMsg]);
      setTextValue("");
      setLoading(true);

      let reply = "";
      let replyLang = language;
      try {
        const res = await fetch(CHAT_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_id: userId, message: text, language }),
        });
        if (!res.ok) throw new Error("Bad response");
        const data = await res.json();
        reply = data.reply;
        replyLang = data.language || language;
      } catch (err) {
        reply = mockChatReply(text, language);
      }

      const assistantMsg = { id: Date.now() + "-a", role: "assistant", text: reply };
      setMessages((prev) => [...prev, assistantMsg]);
      setLoading(false);

      if (viaVoice) speak(reply, replyLang);
