function ChatBubble({ msg, strings, onReplay }) {
  if (msg.kind === "welcome") {
    return (
      <div className="bg-white rounded-3xl shadow-sm border border-teal-50 p-5 mx-1">
        <p className="text-teal-700 font-bold text-lg mb-2">{strings.greetingTitle}</p>
        <p className="text-slate-700 text-[15px] mb-3">{strings.greetingBody}</p>
        <ul className="space-y-2 mb-3">
          {strings.chips.map((c) => (
            <li key={c} className="flex items-center gap-2 text-teal-700 font-medium text-[15px]">
              <CheckCircle2 size={18} className="text-emerald-500 shrink-0" />
              {c}
            </li>
          ))}
        </ul>
        <p className="text-slate-800 font-semibold text-[15px]">{strings.prompt}</p>
      </div>
    );
  }

  const isUser = msg.role === "user";
  return (
    <div className={`flex ${isUser ? "justify-end" : "justify-start"} px-1`}>
      <div
        className={`max-w-[82%] px-4 py-2.5 text-[15px] leading-snug shadow-sm ${
          isUser
            ? "bg-teal-700 text-white rounded-2xl rounded-br-sm"
            : "bg-white text-slate-800 rounded-2xl rounded-bl-sm border border-teal-50"
        }`}
      >
        <p className="whitespace-pre-wrap">{msg.text}</p>
        {!isUser && (
          <button
            onClick={() => onReplay(msg.text)}
            aria-label={strings.replay}
            className="mt-1 -ml-1 text-teal-500 hover:text-teal-700 inline-flex items-center gap-1 text-xs font-semibold"
          >
            <Volume2 size={13} /> {strings.replay}
          </button>
        )}
      </div>
    </div>
  );
}

