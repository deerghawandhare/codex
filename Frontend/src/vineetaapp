export default function VineetaApp() {
  const [language, setLanguage] = useState("en");
  const t = STRINGS[language] || STRINGS.en;

  const [userId] = useState(makeUserId);
  const [messages, setMessages] = useState([{ id: "welcome", kind: "welcome" }]);
  const [loading, setLoading] = useState(false);

  const [inputMode, setInputMode] = useState("voice");
  const [textValue, setTextValue] = useState("");
  const [isListening, setIsListening] = useState(false);
  const [isSpeaking, setIsSpeaking] = useState(false);
  const [viseme, setViseme] = useState("neutral");
  const [micNote, setMicNote] = useState("");

  const [activeTab, setActiveTab] = useState("home");
  const [notifOpen, setNotifOpen] = useState(false);
  const [notifications, setNotifications] = useState([]);
  const [notifLoaded, setNotifLoaded] = useState(false);
  const [notifOffline, setNotifOffline] = useState(false);

  // YouTube and Profile state
  const [youtubeData, setYoutubeData] = useState(MOCK_YOUTUBE_DATA);
  const [profileData, setProfileData] = useState(MOCK_PROFILE);

  const scrollRef = useRef(null);
  const recognitionRef = useRef(null);
  const lipSyncTimerRef = useRef(null);
  const silenceTimerRef = useRef(null);
  const transcriptRef = useRef("");

  const SpeechRecognitionCtor =
    typeof window !== "undefined" ? window.SpeechRecognition || window.webkitSpeechRecognition : null;
  const micSupported = !!SpeechRecognitionCtor;
  const speechSynthSupported = typeof window !== "undefined" && !!window.speechSynthesis;

  useEffect(() => {
    scrollRef.current?.scrollTo({ top: scrollRef.current.scrollHeight, behavior: "smooth" });
  }, [messages, loading]);

  // Setup Speech Recognition with 3-second continuous silence auto-submit
  useEffect(() => {
    if (!SpeechRecognitionCtor) return;
    const recog = new SpeechRecognitionCtor();
    recog.continuous = true; 
    recog.interimResults = true;
    recog.lang = language === "hi" ? "hi-IN" : language === "mr" ? "mr-IN" : "en-IN";

    recog.onstart = () => {
      transcriptRef.current = "";
    };

    recog.onresult = (e) => {
      if (silenceTimerRef.current) clearTimeout(silenceTimerRef.current);

      let currentText = "";
      for (let i = 0; i < e.results.length; i++) {
        currentText += e.results[i][0].transcript;
      }
      transcriptRef.current = currentText;
      setTextValue(currentText);

      silenceTimerRef.current = setTimeout(() => {
        try { recog.stop(); } catch {}
      }, 3000);
    };

    recog.onerror = () => setIsListening(false);
    
    recog.onend = () => {
      setIsListening(false);
      if (silenceTimerRef.current) clearTimeout(silenceTimerRef.current);
      
      if (transcriptRef.current.trim()) {
        sendMessage(transcriptRef.current, { viaVoice: true });
        transcriptRef.current = "";
      }
    };

    recognitionRef.current = recog;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [language]);

  const speak = useCallback(
    (text, forcedLang) => {
      if (!speechSynthSupported || !text) return;
      window.speechSynthesis.cancel();
      if (lipSyncTimerRef.current) clearInterval(lipSyncTimerRef.current);

      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = (forcedLang || language) === "hi" ? "hi-IN" : (forcedLang || language) === "mr" ? "mr-IN" : "en-IN";
      utter.rate = 0.95;

      const visemeSequence = ["open", "wide", "smile", "round", "open", "closed"];
      let visemeIdx = 0;

      utter.onstart = () => {
        setIsSpeaking(true);
        lipSyncTimerRef.current = setInterval(() => {
          setViseme(visemeSequence[visemeIdx % visemeSequence.length]);
          visemeIdx++;
        }, 120);
      };

      utter.onboundary = (e) => {
        if (e.name === "word") {
          const char = e.utterance.text.charAt(e.charIndex).toLowerCase();
          if (["a", "e", "i"].includes(char)) setViseme("wide");
          else if (["o", "u", "w"].includes(char)) setViseme("round");
          else if (["m", "b", "p"].includes(char)) setViseme("closed");
          else setViseme("open");
        }
      };

      const stopSpeaking = () => {
        setIsSpeaking(false);
        setViseme("neutral");
        if (lipSyncTimerRef.current) clearInterval(lipSyncTimerRef.current);
      };

      utter.onend = stopSpeaking;
      utter.onerror = stopSpeaking;

      window.speechSynthesis.speak(utter);
    },
    [language, speechSynthSupported]
