            onClick={(e) => e.stopPropagation()}
          >
            <div className="flex items-center justify-between px-5 py-4 border-b border-teal-50 shrink-0">
              <h2 className="text-teal-800 font-bold text-lg">{t.notifPanelTitle}</h2>
              <button onClick={() => setNotifOpen(false)} aria-label="Close" className="text-slate-400 hover:text-slate-600">
                <X size={20} />
              </button>
            </div>

            <div className="overflow-y-auto px-5 py-3 space-y-3">
              {notifOffline && (
                <p className="text-[12px] text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-1.5">
                  {t.notifError}
                </p>
              )}
              {notifications.length === 0 && notifLoaded && (
                <p className="text-slate-500 text-sm text-center py-6">{t.noNotif}</p>
              )}
              {notifications.map((n) => (
                <div key={n.id} className="border border-teal-50 rounded-2xl p-3.5">
                  <div className="flex items-start justify-between gap-2">
                    <p className="text-slate-800 font-semibold text-[14px]">{n.title}</p>
                    <span className="shrink-0 text-[11px] font-medium text-orange-700 bg-orange-50 border border-orange-100 rounded-full px-2 py-0.5">
                      {n.deadline}
                    </span>
                  </div>
                  <p className="text-slate-500 text-[13px] mt-1">{n.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function NavButton({ icon, label, active, onClick }) {
  return (
    <button onClick={onClick} className={`flex flex-col items-center gap-0.5 px-3 py-1 ${active ? "text-teal-700" : "text-slate-400"}`}>
      {icon}
      <span className="text-[10px] font-medium">{label}</span>
      <span className={`h-0.5 w-5 rounded-full mt-0.5 ${active ? "bg-teal-700" : "bg-transparent"}`} />
    </button>
  );
}

function ProfileSettingItem({ icon, label, value, onClick, isRed }) {
  return (
    <button onClick={onClick} className="w-full flex items-center justify-between p-2.5 rounded-2xl hover:bg-teal-50/50 transition-colors">
      <div className="flex items-center gap-3">
        <div className={`w-9 h-9 rounded-xl ${isRed ? "bg-orange-50" : "bg-teal-50"} flex items-center justify-center`}>
          {icon}
        </div>
        <span className={`text-[14px] font-medium ${isRed ? "text-orange-600" : "text-slate-800"}`}>{label}</span>
      </div>
      <div className="flex items-center gap-2">
        {value && <span className="text-xs text-slate-400 font-medium">{value}</span>}
        <ChevronRight size={16} className="text-slate-400" />
      </div>
    </button>
  );
}
